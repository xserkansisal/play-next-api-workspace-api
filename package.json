{
  "name": "play-next-api-workspace-api",
  "version": "0.1.0",
  "private": true,
  "description": "API service for Play Next workspace",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:check": "drizzle-kit check",
    "presence:seed": "tsx --env-file-if-exists=.env src/presence/seed.ts",
    "presence:clear": "tsx --env-file-if-exists=.env src/presence/clear.ts",
    "mail:check": "tsx --env-file-if-exists=.env src/auth/checkSmtp.ts"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "multer": "^2.4.0",
    "mysql2": "^3.24.5",
    "nodemailer": "^10.0.12",
    "quickjs-emscripten": "^0.32.0",
    "sharp": "^0.35.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.4",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  }
}
