NODE_ENV=development
HOST=0.0.0.0
PORT=3000
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=play_next_api
MYSQL_PASSWORD=
MYSQL_DATABASE=play_next_api
CORS_ORIGIN=http://localhost:5173
SSE_HEARTBEAT_MS=15000
SSE_RETRY_MS=3000
# HMAC key for sign-in codes. This placeholder is fine locally but production refuses it.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_CODE_PEPPER=replace-with-a-random-secret-at-least-32-characters
AUTH_CODE_TTL_SECONDS=900
AUTH_CODE_MAX_ATTEMPTS=5
AUTH_CODE_REQUEST_LIMIT=3
AUTH_CODE_REQUEST_WINDOW_SECONDS=900
AUTH_CODE_VERIFY_LIMIT=10
AUTH_CODE_VERIFY_WINDOW_SECONDS=900
AUTH_SESSION_TTL_SECONDS=2592000
# Defaults by NODE_ENV: play_next_session (production), play_next_session_dev, play_next_session_test.
# AUTH_COOKIE_NAME=
AUTH_COOKIE_SECURE=false
AUTH_DEV_INBOX_TOKEN=
# Development only: enables POST /api/v1/auth/dev-login, which signs in with an email and no code.
# Startup fails if this is true while NODE_ENV is not development.
AUTH_DEV_BYPASS=false
# Real email delivery switches on as soon as SMTP_HOST and SMTP_FROM are both set, in any
# NODE_ENV; leave either unset to use the in-memory sender, which delivers nothing. Production
# refuses to start without them. SMTP_SECURE means implicit TLS (port 465); on 587 leave it false,
# since that port upgrades through STARTTLS. Set SMTP_USER and SMTP_PASSWORD together or not at
# all. Check the settings with `npm run mail:check` before relying on them.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Server-side request execution, for targets that do not send CORS headers and so cannot be reached
# from the browser. Disabled while this is empty: an open proxy inside a private network is worth
# more to an attacker than one on the public internet, because this process can reach hosts they
# cannot. List only the hosts that should be reachable, as "host" or "host:port", comma separated.
# Set it to "*" to allow every host. That removes the allow-list entirely and makes this an open
# proxy for every signed-in user, including anything bound to loopback on this machine, so use it
# only on a trusted machine you control.
PROXY_ALLOWED_HOSTS=
PROXY_TIMEOUT_MS=30000
PROXY_MAX_RESPONSE_BYTES=10485760

# Development/test only: simulate persisted test users as live workspace viewers.
PRESENCE_SIMULATOR_ENABLED=false
