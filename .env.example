NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_PATH=./data/api.sqlite
CORS_ORIGIN=http://localhost:5173
SSE_HEARTBEAT_MS=15000
SSE_RETRY_MS=3000
AUTH_CODE_PEPPER=replace-with-a-random-secret-at-least-32-characters
AUTH_CODE_TTL_SECONDS=900
AUTH_CODE_MAX_ATTEMPTS=5
AUTH_CODE_REQUEST_LIMIT=3
AUTH_CODE_REQUEST_WINDOW_SECONDS=900
AUTH_CODE_VERIFY_LIMIT=10
AUTH_CODE_VERIFY_WINDOW_SECONDS=900
AUTH_SESSION_TTL_SECONDS=2592000
AUTH_COOKIE_NAME=play_next_session
AUTH_COOKIE_SECURE=false
AUTH_DEV_INBOX_TOKEN=
# SMTP is required in production; leave unset for the in-memory development sender.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Server-side request execution, for targets that do not send CORS headers and so cannot be reached
# from the browser. Disabled while this is empty: an open proxy inside a private network is worth
# more to an attacker than one on the public internet, because this process can reach hosts they
# cannot. List only the hosts that should be reachable, as "host" or "host:port", comma separated.
PROXY_ALLOWED_HOSTS=
PROXY_TIMEOUT_MS=30000
PROXY_MAX_RESPONSE_BYTES=10485760
